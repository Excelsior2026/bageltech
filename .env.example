# Existing BagelTech application settings
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://www.bageltech.net
NEXT_PUBLIC_API_URL=https://verify.bageltech.net

# Contractor-platform onboarding handoff
# The URL must be HTTPS in production. Never expose these values to the browser.
CONTRACTOR_PLATFORM_INTAKE_URL=
CONTRACTOR_PLATFORM_INTAKE_KEY_ID=
CONTRACTOR_PLATFORM_INTAKE_SECRET=

# Contractor Custom Studio blueprint generation
# AI remains off unless explicitly enabled, a Gateway model is selected, the
# privacy/rate-limit secret is at least 32 characters, and Gateway auth exists.
CUSTOM_SITE_AI_ENABLED=false
CUSTOM_SITE_AI_MODEL=
CUSTOM_SITE_AI_RATE_LIMIT_SECRET=
# Optional on Vercel when project OIDC authentication is enabled.
AI_GATEWAY_API_KEY=
